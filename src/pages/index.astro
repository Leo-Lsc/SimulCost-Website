---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import Footer from "../components/Footer.astro";
import { sections, citation } from "../content/site.config";
---

<BaseLayout>
	<Navbar />
	<Hero />

	<!-- Overview Image -->
	<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-4 pb-2">
		<img
			src="/images/overview_v4.webp"
			alt="SimulCost system overview"
			class="w-full rounded-xl border border-brand-border shadow-sm"
			loading="lazy"
		/>
	</div>

	<!-- About Section -->
	<Section id="about" label="About" title="What does SimulCost do for you?">
		<div class="space-y-4">
			{sections.abstract.split('\n\n').map((paragraph) => (
				<div set:html={paragraph.replace(/\n/g, '<br />')} />
			))}
		</div>
	</Section>

	<!-- Simulators Section -->
	<Section id="simulators" label="Methodology" title="How does SimulCost work?">
		<div class="space-y-4">
			{sections.simulators.split('\n\n').map((paragraph) => (
				<div set:html={paragraph.replace(/\n/g, '<br />')} />
			))}
		</div>
	</Section>

	<!-- Results Section -->
	<Section id="results" label="Results" title="Main Results">
		<div class="space-y-6">
			{sections.results.split('\n\n').slice(0, 1).map((p) => (
				<div set:html={p.replace(/\n/g, '<br />')} />
			))}
			<img
				src="/images/fig%202.webp"
				alt="Figure 2: Success rate and cost efficiency in single-round and multi-round modes"
				class="w-full rounded-xl border border-brand-border shadow-sm"
				loading="lazy"
			/>
			{sections.results.split('\n\n').slice(1, 2).map((p) => (
				<div set:html={p.replace(/\n/g, '<br />')} />
			))}
			<img
				src="/images/fig%203.webp"
				alt="Figure 3: Accuracy-level effects, parameter-group effects, transfer limits, and ICL trade-offs"
				class="w-full rounded-xl border border-brand-border shadow-sm"
				loading="lazy"
			/>
			{sections.results.split('\n\n').slice(2).map((p) => (
				<div set:html={p.replace(/\n/g, '<br />')} />
			))}
		</div>
	</Section>

	<!-- Findings Section -->
	<Section id="findings" label="Findings" title="Key Findings">
		<ul class="space-y-2 list-disc list-outside pl-5">
			{sections.findings.split('\n').filter((l) => l.startsWith('- ')).map((l) => (
				<li set:html={l.slice(2).replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')} />
			))}
		</ul>
	</Section>

	<!-- Conclusions Section -->
	<Section id="conclusions" label="Conclusions" title="Conclusions">
		<div class="space-y-4">
			{sections.conclusions.split('\n\n').map((paragraph) => (
				<div set:html={paragraph.replace(/\n/g, '<br />')} />
			))}
		</div>
	</Section>

	<!-- Citation Section -->
	<Section id="citation" label="Citation" title="Citation">
		<div class="space-y-4">
			<p>If you find SimulCost useful in your research, please cite our work:</p>

			<div class="relative">
				<pre
					class="bg-brand-surface border border-brand-border rounded-lg p-6 overflow-x-auto text-sm font-mono text-brand-text-primary"
					id="citation-text"
				>{citation}</pre>

				<button
					id="copy-citation-btn"
					class="absolute top-4 right-4 px-4 py-2 bg-brand-accent-cyan/10 hover:bg-brand-accent-cyan/20 border border-brand-accent-cyan/30 text-brand-accent-cyan rounded-md text-sm font-medium transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-brand-accent-cyan"
					aria-label="Copy citation to clipboard"
				>
					<span class="flex items-center gap-2">
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
						</svg>
						<span class="copy-btn-text">Copy</span>
					</span>
				</button>
			</div>
		</div>
	</Section>

	<Footer />

	<!-- Citation copy functionality -->
	<script>
		document.addEventListener('DOMContentLoaded', () => {
			const copyBtn = document.getElementById('copy-citation-btn');
			const citationText = document.getElementById('citation-text');
			const btnText = document.querySelector('.copy-btn-text');

			if (!copyBtn || !citationText || !btnText) return;

			copyBtn.addEventListener('click', async () => {
				const text = citationText.textContent || '';

				try {
					// Try modern clipboard API first
					if (navigator.clipboard && window.isSecureContext) {
						await navigator.clipboard.writeText(text);
						showCopiedFeedback();
					} else {
						// Fallback for older browsers or non-secure contexts
						const textArea = document.createElement('textarea');
						textArea.value = text;
						textArea.style.position = 'fixed';
						textArea.style.left = '-999999px';
						document.body.appendChild(textArea);
						textArea.select();

						try {
							document.execCommand('copy');
							showCopiedFeedback();
						} catch (err) {
							console.error('Failed to copy:', err);
						} finally {
							document.body.removeChild(textArea);
						}
					}
				} catch (err) {
					console.error('Failed to copy:', err);
				}
			});

			function showCopiedFeedback() {
				const originalText = btnText.textContent;
				btnText.textContent = 'Copied!';
				copyBtn?.classList.add('bg-brand-accent-cyan/30');

				setTimeout(() => {
					btnText.textContent = originalText;
					copyBtn?.classList.remove('bg-brand-accent-cyan/30');
				}, 2000);
			}
		});
	</script>
</BaseLayout>
