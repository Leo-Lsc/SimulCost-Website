---
interface Props {
	id: string;
	label: string;
	title: string;
	tag?: string;
}

const { id, label, title, tag } = Astro.props;
---

<section id={id} class="py-8">
	<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
		<div class="flex items-center justify-between mb-6">
			<div class="text-sm font-semibold text-brand-accent-cyan uppercase tracking-wider">
				{label}
			</div>
			{tag && (
				<span class="px-3 py-1 text-xs font-medium bg-brand-accent-indigo/20 text-brand-accent-indigo rounded-full border border-brand-accent-indigo/30">
					{tag}
				</span>
			)}
		</div>
		<h2 class="text-4xl font-bold mb-8 text-brand-text-primary">
			{title}
		</h2>
		<div class="prose prose-invert prose-lg max-w-none text-brand-text-secondary leading-relaxed">
			<slot />
		</div>
	</div>
</section>
