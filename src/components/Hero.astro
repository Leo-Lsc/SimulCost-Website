---
import { siteTitle, siteSubtitle, authors, affiliations, links } from "../content/site.config";
import ButtonLink from "./ButtonLink.astro";
---

<section class="relative pt-32 pb-8 overflow-hidden">
	<!-- Background glow -->
	<div class="absolute top-1/4 right-1/4 w-96 h-96 bg-brand-accent-cyan opacity-5 rounded-full blur-3xl pointer-events-none"></div>

	<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
		<!-- Title -->
		<div class="text-center mb-8">
			<h1 class="text-6xl md:text-7xl font-extrabold mb-6 bg-gradient-to-r from-brand-text-primary via-brand-accent-cyan to-brand-accent-indigo bg-clip-text text-transparent">
				{siteTitle}
			</h1>
			<p class="text-2xl md:text-3xl text-brand-text-secondary font-light max-w-4xl mx-auto">
				{siteSubtitle}
			</p>
		</div>

		<!-- Authors -->
		<div class="text-center mb-4 space-y-1">
			{[
				{ row: authors.slice(0, 4),  offset: 0  },
				{ row: authors.slice(4, 9),  offset: 4  },
				{ row: authors.slice(9, 14), offset: 9  },
				{ row: authors.slice(14),    offset: 14 },
			].map(({ row, offset }) => (
				<div class="flex flex-wrap justify-center gap-x-5 gap-y-1 text-base text-brand-text-primary">
					{row.map((author, i) => (
						<span>
							<span class="font-medium">{author.name}</span>
							{author.coFirst && <sup class="text-brand-accent-cyan font-semibold">†</sup>}
							{author.affiliationIndices.map(n => (
								<sup class="text-brand-text-secondary">{n}</sup>
							))}
							{(offset + i) < authors.length - 1 && <span class="text-brand-text-secondary">,</span>}
						</span>
					))}
				</div>
			))}
		</div>

		<!-- Legend -->
		<div class="flex flex-wrap justify-center gap-x-6 gap-y-1 text-sm text-brand-text-secondary mb-8">
			<span><sup class="text-brand-accent-cyan font-semibold">†</sup> Equal contribution</span>
			{affiliations.map(aff => (
				<span><sup>{aff.index}</sup> {aff.name}</span>
			))}
		</div>

		<!-- Links/Buttons -->
		<div class="flex flex-wrap justify-center gap-4">
			<ButtonLink href={links.paper} icon="document" variant="secondary" label="Paper" />
			<ButtonLink href={links.code} icon="code" variant="secondary" label="Code" />
			<ButtonLink href={links.dataset} icon="database" variant="secondary" label="Dataset" />
			<ButtonLink href={links.cacheBaseline} icon="cache" variant="secondary" label="Cache (Baseline)" />
			<ButtonLink href={links.cacheFull} icon="cache" variant="secondary" label="Cache (Full)" />
		</div>
	</div>
</section>
