---
interface Props {
	href: string;
	icon: 'document' | 'code' | 'database' | 'cache';
	variant?: 'primary' | 'secondary';
	label: string;
}

const { href, icon, variant = 'secondary', label } = Astro.props;

const icons = {
	document: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
	</svg>`,
	code: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
	</svg>`,
	database: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4" />
	</svg>`,
	cache: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" />
	</svg>`,
};

const baseClasses = "inline-flex items-center gap-2 px-6 py-3 rounded-full font-medium transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-brand-accent-cyan focus:ring-offset-2 focus:ring-offset-brand-bg";

const variantClasses = {
	primary: "bg-transparent border-2 border-brand-accent-cyan text-brand-accent-cyan hover:bg-brand-accent-cyan/10 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-brand-accent-cyan/20",
	secondary: "bg-brand-surface border border-brand-border text-brand-text-primary hover:bg-brand-surface/80 hover:-translate-y-0.5 hover:shadow-lg hover:border-brand-accent-cyan/50",
};
---

<a href={href} class={`${baseClasses} ${variantClasses[variant]}`} target="_blank" rel="noopener noreferrer">
	<span set:html={icons[icon]} />
	<span>{label}</span>
</a>
